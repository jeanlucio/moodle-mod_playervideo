{{!
    @template mod_playervideo/grading_card

    One response card in the open-question correction queue: question and answer context plus
    the grade and feedback form the teacher confirms via review_response. Rendered client-side
    via core/templates from amd/src/grading.js, which then wires the Generate and Confirm
    buttons. Only questiontext is trusted HTML (format_text()'d with the module context on the
    server, question_service), so it alone is rendered unescaped; responsetext and aifeedback
    are PARAM_TEXT and escaped by the template.

    Example context (json):
    {
        "responseid": 42,
        "fullname": "Ada Lovelace",
        "timedisplay": "1:20",
        "questiontext": "<p>Explain photosynthesis.</p>",
        "responsetext": "Plants turn light into energy.",
        "maxgrade": 1,
        "gradevalue": "0.8",
        "aifeedback": "Good start, add the role of chlorophyll."
    }
}}
<div class="card mb-3 p-3" data-responseid="{{responseid}}">
    <div class="d-flex justify-content-between">
        <strong>{{fullname}}</strong>
        <span class="mono">{{timedisplay}}</span>
    </div>
    <div class="mt-1">{{{questiontext}}}</div>
    <label class="playervideo-field-label mt-2">{{#str}}studentanswerlabel, mod_playervideo{{/str}}</label>
    <div class="playervideo-student-answer">{{responsetext}}</div>
    <div class="playervideo-ai-block mt-2"></div>
    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-action="generate">
        {{#str}}generate, mod_playervideo{{/str}}
    </button>
    <label class="playervideo-field-label mt-2" for="playervideo-grade-{{responseid}}">
        {{#str}}gradelabel, mod_playervideo{{/str}} (0&ndash;{{maxgrade}})
    </label>
    <input type="number" min="0" max="{{maxgrade}}" step="0.01" class="form-control mb-2"
        id="playervideo-grade-{{responseid}}" value="{{gradevalue}}">
    <label class="playervideo-field-label" for="playervideo-feedback-{{responseid}}">
        {{#str}}feedbacklabel, mod_playervideo{{/str}}
    </label>
    <textarea class="form-control mb-2" id="playervideo-feedback-{{responseid}}">{{aifeedback}}</textarea>
    <button type="button" class="btn btn-primary btn-sm" data-action="confirm">
        {{#str}}confirmgrade, mod_playervideo{{/str}}
    </button>
</div>
