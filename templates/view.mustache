{{!
    @template mod_playervideo/view

    The student-facing activity page: an info panel (previous attempts to review, a pending-
    correction notice, accessibility links), the interactive player screen — visible from the
    first render, no separate start button — and the onboarding content shown automatically on
    a student's first visit to any PlayerVideo activity on the site. The video is loaded and
    scrubbable right away; the attempt itself is only opened on the student's first play click
    (amd/src/player.js). showplayer (canattempt AND canstart, computed server-side) decides
    whether the player screen renders at all; when it does not, the poster image (if any) is
    shown as a plain static image in the info panel instead of as the video overlay. The full
    interactions/embed data set is passed separately, via a hidden application/json data
    island (see lib/data-passing conventions), not through this context.

    Example context (json):
    {
        "introbody": "<p>This video pauses at marked points to show a question or a note.</p>",
        "canattempt": true,
        "showplayer": true,
        "pendingcorrectionnotice": "",
        "previousattempts": [
            {"attemptid": 5, "attemptnumber": 1, "gradeline": "Grade: 80", "pending": false}
        ],
        "hasposter": true,
        "posterurl": "https://example.com/pluginfile.php/1/mod_playervideo/posterimage/0/cover.jpg",
        "posterdescription": "A microscope focused on a leaf cross-section."
    }
}}
<div class="path-mod-playervideo">
    {{!
        The activity description is rendered once by the course's incourse page layout via
        $PAGE->activityheader — never repeat format_module_intro() here, or every drop shortcode
        (or any other filtered content) in the description renders twice on the page.
    }}
    <div id="playervideo-onboarding-content" hidden>{{{introbody}}}</div>

    <div id="playervideo-idle-info">
        {{^showplayer}}
        {{#hasposter}}
        <img src="{{posterurl}}" alt="{{posterdescription}}" class="playervideo-poster">
        {{/hasposter}}
        {{/showplayer}}
        {{^canattempt}}
        <div class="alert alert-warning">{{#str}}cannotattempt, mod_playervideo{{/str}}</div>
        {{/canattempt}}
        {{#canattempt}}
        {{#previousattempts.0}}
        <h3 class="h5">{{#str}}reviewpreviousattempts, mod_playervideo{{/str}}</h3>
        <ul class="list-group mb-3" id="playervideo-previous-attempts">
            {{#previousattempts}}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>{{#str}}attemptnumber, mod_playervideo, {{attemptnumber}}{{/str}} — {{gradeline}}</span>
                <button type="button" class="btn btn-sm btn-secondary playervideo-review-btn" data-attemptid="{{attemptid}}">
                    {{#str}}reviewattempt, mod_playervideo{{/str}}
                </button>
            </li>
            {{/previousattempts}}
        </ul>
        {{/previousattempts.0}}
        {{#pendingcorrectionnotice}}
        <div class="alert alert-info">{{pendingcorrectionnotice}}</div>
        {{/pendingcorrectionnotice}}
        <div class="playervideo-accessibility-links mt-2">
            {{#hasdisummary}}
            <button type="button" class="btn btn-link p-0" id="playervideo-disummary-btn">
                {{#str}}disummary, mod_playervideo{{/str}}
            </button>
            {{/hasdisummary}}
            <a href="{{transcripturl}}" id="playervideo-transcript-link">
                {{#str}}transcriptmode, mod_playervideo{{/str}}
            </a>
        </div>
        {{/canattempt}}
    </div>

    <div id="playervideo-player-screen" {{^showplayer}}hidden{{/showplayer}}>
        <div id="playervideo-announcer" class="visually-hidden" aria-live="polite"></div>
        <div class="playervideo-stage mb-3" id="playervideo-stage">
            <div class="playervideo-video-wrapper">
                <div id="playervideo-target" class="ph-video-embed"></div>
                {{#hasposter}}
                <img src="{{posterurl}}" alt="{{posterdescription}}" class="playervideo-poster-overlay"
                    id="playervideo-poster">
                {{/hasposter}}
                <div id="playervideo-caption-overlay" class="playervideo-caption-overlay" hidden></div>
            </div>
            <div class="playervideo-timeline-wrap">
                <div class="playervideo-timeline-spacer" aria-hidden="true"></div>
                <div class="playervideo-timeline-ruler mono" aria-hidden="true">
                    <span id="playervideo-ruler-start">0:00</span>
                    <span id="playervideo-ruler-end">&nbsp;</span>
                </div>
                <button type="button" class="playervideo-playpause-btn" id="playervideo-playpause-btn"
                    aria-label="{{#str}}play, mod_playervideo{{/str}}">
                    <span class="playervideo-playpause-icon" aria-hidden="true"></span>
                </button>
                <div class="playervideo-timeline" id="playervideo-timeline" role="group"
                    aria-label="{{#str}}timelinelabel, mod_playervideo{{/str}}">
                    <div class="playervideo-timeline-track"></div>
                    <div class="playervideo-playhead" id="playervideo-playhead"></div>
                    <div id="playervideo-markers"></div>
                </div>
                <div class="playervideo-playback-controls">
                    <div class="playervideo-speed-controls">
                        <label class="visually-hidden" for="playervideo-speed-select">
                            {{#str}}playbackspeed, mod_playervideo{{/str}}
                        </label>
                        <select class="form-select form-select-sm" id="playervideo-speed-select">
                            <option value="0.5">0.5x</option>
                            <option value="0.75">0.75x</option>
                            <option value="1" selected>1x</option>
                            <option value="1.25">1.25x</option>
                            <option value="1.5">1.5x</option>
                            <option value="2">2x</option>
                        </select>
                    </div>
                    <div class="playervideo-caption-controls">
                        <label class="visually-hidden" for="playervideo-caption-select">
                            {{#str}}subtitles, mod_playervideo{{/str}}
                        </label>
                        <select class="form-select form-select-sm" id="playervideo-caption-select">
                            <option value="">{{#str}}subtitlesoff, mod_playervideo{{/str}}</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="playervideo-transcript-toggle"
                        aria-expanded="false" aria-controls="playervideo-transcript-panel" hidden>
                        {{#str}}transcriptpanel, mod_playervideo{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="playervideo-fullscreen-btn"
                        aria-label="{{#str}}fullscreen, mod_playervideo{{/str}}">
                        <i class="fa fa-expand" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="playervideo-transcript-panel card mb-3" id="playervideo-transcript-panel" hidden>
            <div class="card-body">
                <label class="visually-hidden" for="playervideo-transcript-search">
                    {{#str}}searchtranscript, mod_playervideo{{/str}}
                </label>
                <input type="search" class="form-control form-control-sm mb-2" id="playervideo-transcript-search"
                    placeholder="{{#str}}searchtranscript, mod_playervideo{{/str}}">
                <div id="playervideo-transcript-list" class="playervideo-transcript-list"></div>
            </div>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="playervideo-finish-btn" hidden>
            {{#str}}finishattempt, mod_playervideo{{/str}}
        </button>
        <div id="playervideo-interaction-overlay" class="card" hidden></div>
        <div id="playervideo-review-overlay" class="card" hidden></div>
    </div>

    <div id="playervideo-summary-screen" hidden></div>
</div>
