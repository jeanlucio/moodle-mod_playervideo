{{!
    @template mod_playervideo/view

    Placeholder activity page — the interactive player timeline is built in a later phase.
    Also carries the hidden onboarding content shown automatically, once, on a student's
    first visit to any PlayerVideo activity on the whole site.

    Example context (json):
    {
        "intro": "<p>Watch the video and answer as you go.</p>",
        "placeholdertext": "The interactive player is coming in a later phase.",
        "introbody": "<p>This video pauses at marked points to show a question or a note.</p>"
    }
}}
<div class="path-mod-playervideo">
    {{#intro}}
    <div class="playervideo-intro">{{{intro}}}</div>
    {{/intro}}
    <div class="alert alert-info" id="playervideo-placeholder">{{placeholdertext}}</div>
    <div id="playervideo-onboarding-content" hidden>{{{introbody}}}</div>
</div>
