{{!
    @template mod_playervideo/interactions_editor

    Timeline management screen (Fase 3c redesign): a video "stage" with a real, clickable/
    draggable timeline below it (markers for existing interactions, handles for the trim
    window) on one side, and a docked panel that alternates between a type picker (add a new
    marker) and a focused editor form on the other. Everything inside the stage and the panel
    is built by amd/src/interactions_editor.js — this template only renders the static shell,
    the same split this plugin already uses for the student player (view.mustache /
    amd/src/player.js). The interactions/trim data itself travels via a hidden JSON data
    island (#playervideo-editor-data, embedded by interactions.php), not through this context.

    Example context (json):
    {
        "noembed": false
    }
}}
<div class="path-mod-playervideo playervideo-editor" id="playervideo-interactions-editor">
    <div class="playervideo-stage">
        <div class="playervideo-video-wrapper">
            <div id="playervideo-target" class="ph-video-embed"></div>
        </div>
        {{#noembed}}
        <div class="alert alert-warning" id="playervideo-noembed">{{#str}}error_noembed, mod_playervideo{{/str}}</div>
        {{/noembed}}

        <div class="playervideo-timeline-wrap">
            <div class="playervideo-timeline-row">
                <button type="button" class="playervideo-playpause-btn" id="playervideo-playpause-btn"
                    aria-label="{{#str}}play, mod_playervideo{{/str}}">
                    <span class="playervideo-playpause-icon" aria-hidden="true"></span>
                </button>
                <div class="playervideo-timeline-main">
                    <div class="playervideo-timeline-ruler mono" aria-hidden="true">
                        <span id="playervideo-ruler-start">0:00</span>
                        <span id="playervideo-ruler-end">&nbsp;</span>
                    </div>
                    <div class="playervideo-timeline" id="playervideo-timeline" role="group" aria-label="{{#str}}timelinelabel, mod_playervideo{{/str}}">
                        <div class="playervideo-timeline-track"></div>
                        <div class="playervideo-trim-shade" id="playervideo-trim-shade-start"></div>
                        <div class="playervideo-trim-shade" id="playervideo-trim-shade-end"></div>
                        <div class="playervideo-playhead" id="playervideo-playhead"></div>
                        <button type="button" class="playervideo-trim-handle" id="playervideo-trim-handle-start"
                            aria-label="{{#str}}trimstart, mod_playervideo{{/str}}"></button>
                        <button type="button" class="playervideo-trim-handle" id="playervideo-trim-handle-end"
                            aria-label="{{#str}}trimend, mod_playervideo{{/str}}"></button>
                        <div id="playervideo-markers"></div>
                    </div>
                </div>
            </div>
            <div class="playervideo-timeline-legend">
                <span class="item"><span class="playervideo-swatch playervideo-swatch-question"></span> {{#str}}typequestion, mod_playervideo{{/str}}</span>
                <span class="item"><span class="playervideo-swatch playervideo-swatch-note"></span> {{#str}}typenote, mod_playervideo{{/str}}</span>
                <span class="item"><span class="playervideo-swatch playervideo-swatch-poll"></span> {{#str}}typepoll, mod_playervideo{{/str}}</span>
                <span class="item">{{#str}}timelinehint, mod_playervideo{{/str}}</span>
            </div>
        </div>

        <div class="playervideo-stage-toolbar">
            <span class="playervideo-addhint" id="playervideo-add-hint"></span>
            <button type="button" class="btn btn-outline-secondary" id="playervideo-add-here-btn">
                {{#str}}addhere, mod_playervideo{{/str}}
            </button>
        </div>
    </div>

    <aside class="playervideo-panel">
        <div class="playervideo-panel-body" id="playervideo-panel-body"></div>
        <div class="playervideo-panel-footer" id="playervideo-panel-footer" hidden></div>
        <div class="playervideo-outline">
            <h2 class="playervideo-section-title">{{#str}}allmarkers, mod_playervideo{{/str}}</h2>
            <ul class="playervideo-outline-list" id="playervideo-outline-list"></ul>
            <div class="alert alert-info" id="playervideo-empty-list" hidden>{{#str}}nointeractions, mod_playervideo{{/str}}</div>
        </div>
    </aside>
</div>
