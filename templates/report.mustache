{{!
    @template mod_playervideo/report

    Shell for the correction queue (amd/src/grading.js) and the analytics dashboard
    (amd/src/report.js) — each section renders only when the current user has the matching
    capability, and each fills its own container dynamically; this template only lays out
    the static shell (see the plugin SCOPE, "Correção assistida" and "Analytics").

    Example context (json):
    {
        "canreview": true,
        "canviewreports": true
    }
}}
<div class="path-mod-playervideo">
    {{#canreview}}
    <section class="mb-4">
        <h3 class="h5">{{#str}}pendingcorrectionsheader, mod_playervideo{{/str}}</h3>
        <div id="playervideo-grading-list"></div>
    </section>
    {{/canreview}}
    {{#canviewreports}}
    <section>
        <h3 class="h5">{{#str}}questionreportheader, mod_playervideo{{/str}}</h3>
        <div id="playervideo-report-questions" class="table-responsive mb-4"></div>
        <h3 class="h5">{{#str}}studentreportheader, mod_playervideo{{/str}}</h3>
        <div id="playervideo-report-students" class="table-responsive"></div>
    </section>
    {{/canviewreports}}
</div>
