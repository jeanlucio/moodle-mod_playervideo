{{!
    @template mod_playervideo/transcript

    Text-only linear document: the activity's caption text and interactions merged by
    timestamp, for a student navigating with a screen reader (see the plugin SCOPE, "Modo
    texto-only"). amd/src/transcript.js fills #playervideo-transcript-blocks from the data
    island transcript.php embeds; this template only renders the static shell.

    Example context (json):
    {
        "backtovideourl": "https://example.com/mod/playervideo/view.php?id=5"
    }
}}
<div class="path-mod-playervideo playervideo-transcript">
    <div id="playervideo-transcript-announcer" class="visually-hidden" aria-live="polite"></div>
    <p>
        <a href="{{backtovideourl}}" id="playervideo-back-to-video">
            {{#str}}backtoactivity, mod_playervideo{{/str}}
        </a>
    </p>
    <div id="playervideo-transcript-blocks"></div>
    <button type="button" class="btn btn-primary mt-3" id="playervideo-transcript-finish-btn" hidden>
        {{#str}}finishattempt, mod_playervideo{{/str}}
    </button>
    <div id="playervideo-transcript-summary" class="alert alert-info mt-3" hidden></div>
</div>
