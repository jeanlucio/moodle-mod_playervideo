{{!
    @template mod_playervideo/report_students

    The analytics dashboard's per-student table. Rendered client-side via core/templates from
    amd/src/report.js with mod_playervideo_get_report's "bystudent" rows. No value here is
    trusted HTML: every field is escaped by the template.

    Example context (json):
    {
        "rows": [
            {"fullname": "Ada Lovelace", "attemptscount": 2, "gradedisplay": "8.5",
             "watcheddisplay": "90%", "completeddisplay": "Yes"}
        ]
    }
}}
{{#rows.0}}
<table class="table table-sm">
    <thead>
        <tr>
            <th scope="col">{{#str}}columnstudent, mod_playervideo{{/str}}</th>
            <th scope="col">{{#str}}columnattempts, mod_playervideo{{/str}}</th>
            <th scope="col">{{#str}}gradelabel, mod_playervideo{{/str}}</th>
            <th scope="col">{{#str}}columnwatched, mod_playervideo{{/str}}</th>
            <th scope="col">{{#str}}columncompleted, mod_playervideo{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td>{{fullname}}</td>
            <td>{{attemptscount}}</td>
            <td>{{gradedisplay}}</td>
            <td>{{watcheddisplay}}</td>
            <td>{{completeddisplay}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/rows.0}}
{{^rows.0}}
<p>{{#str}}nostudentreport, mod_playervideo{{/str}}</p>
{{/rows.0}}
