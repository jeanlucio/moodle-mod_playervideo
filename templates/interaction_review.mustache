{{!
    @template mod_playervideo/interaction_review

    Read-only overlay content for one interaction, shown while a student replays a finished
    attempt (review mode, see the plugin SCOPE "Modo revisão"). A separate partial from the
    live/editable overlay on purpose: mixing an editable form and a read-only display in the
    same template would need a condition on every field. Rendered client-side via
    core/templates from amd/src/player.js, once per interaction the video pauses on.

    Example context (json):
    {
        "isnote": false,
        "isquestion": true,
        "notetext": "",
        "questiontext": "<p>What is the capital of France?</p>",
        "options": [
            {"id": 1, "text": "Paris", "correct": true, "selected": true},
            {"id": 2, "text": "Lyon", "correct": false, "selected": false}
        ],
        "hasresponsetext": false,
        "responsetext": "",
        "resultlabel": "Correct",
        "resultclass": "badge-success",
        "hasteacherfeedback": false,
        "teacherfeedback": ""
    }
}}
<div id="playervideo-review-content">
    {{#isnote}}
    <p>{{{notetext}}}</p>
    {{/isnote}}
    {{#isquestion}}
    <p>{{{questiontext}}}</p>
    <ul class="list-group mb-2">
        {{#options}}
        <li class="list-group-item {{#correct}}list-group-item-success{{/correct}} {{#selected}}fw-bold{{/selected}}">
            {{text}}
            {{#selected}}<span class="ms-2">({{#str}}yourresponse, mod_playervideo{{/str}})</span>{{/selected}}
            {{#correct}}<span class="ms-2">({{#str}}correctanswer, mod_playervideo{{/str}})</span>{{/correct}}
        </li>
        {{/options}}
    </ul>
    {{#hasresponsetext}}
    <p><strong>{{#str}}yourresponse, mod_playervideo{{/str}}:</strong> {{responsetext}}</p>
    {{/hasresponsetext}}
    <p><span class="badge {{resultclass}}">{{resultlabel}}</span></p>
    {{#hasteacherfeedback}}
    <p>{{teacherfeedback}}</p>
    {{/hasteacherfeedback}}
    {{/isquestion}}
    <button type="button" class="btn btn-secondary" id="playervideo-review-continue">{{#str}}continuewatching, mod_playervideo{{/str}}</button>
</div>
